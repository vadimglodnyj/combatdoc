# Database
DATABASE_URL="postgresql://combatdoc:combatdoc_dev@localhost:5432/combatdoc"

# HTTP
PORT=3000
CORS_ORIGIN=http://localhost:4200

# JWT Auth
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Discord (get from Discord Developer Portal)
DISCORD_BOT_TOKEN=
DISCORD_WEBHOOK_URL=

# WhatsApp (configure based on your provider)
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_CHAT_1_ID=
WHATSAPP_CHAT_2_ID=

# Optional: Document generation
DOCS_TEMPLATE_PATH=./templates

# Optional: File storage
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Optional: OCR/AI for injury certificates
GEMINI_API_KEY=
