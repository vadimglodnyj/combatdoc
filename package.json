{
  "name": "combatdoc",
  "version": "0.1.0",
  "private": true,
  "description": "Медхар 2.0 / CombatDOC — облік військовослужбовців НГУ",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api:dev": "pnpm --filter api dev",
    "api:free-port": "node scripts/free-port.cjs",
    "api:build": "pnpm --filter api build",
    "api:start": "pnpm --filter api start:prod",
    "web:dev": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build",
    "web:start": "pnpm --filter web start",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:studio": "pnpm --filter api db:studio",
    "db:seed": "pnpm --filter api db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "install:all": "pnpm install",
    "dev": "pnpm docker:up && concurrently -n api,web -c cyan,magenta \"pnpm api:dev\" \"pnpm web:dev\"",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
